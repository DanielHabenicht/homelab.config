# Backup of the super-productivity stack
BACKUP_SOURCES=/backup/super-productivity
BACKUP_FILENAME="super-productivity-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=super-productivity-
# Stops all containers labeled docker-volume-backup.stop-during-backup=super-productivity
BACKUP_STOP_DURING_BACKUP_LABEL=super-productivity
