# Backup of the mailarchiva stack
# MailArchiva supports copying the volume store while running
BACKUP_SOURCES=/backup/mailarchiva
BACKUP_FILENAME="mailarchiva-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=mailarchiva-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=mailarchiva
