# Weekly backup of the git-backup stack (schedule and retention: defaults in docker-compose.yml)
# Plain files
BACKUP_SOURCES=/backup/git-backup
BACKUP_FILENAME="git-backup-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=git-backup-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=git-backup
