# Backup of the n8n stack
# SQLite database: stop and copy the data folder (CLI exports only cover workflows/credentials)
BACKUP_SOURCES=/backup/n8n
BACKUP_FILENAME="n8n-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=n8n-
BACKUP_STOP_DURING_BACKUP_LABEL=n8n
# Only run commands from containers labeled for this stack
EXEC_LABEL=n8n
