# Backup of the endurain stack
# pg_dumpall to db-dump/ (label on the db service) + activity files and images
BACKUP_SOURCES=/backup/endurain
BACKUP_FILENAME="endurain-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=endurain-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=endurain
