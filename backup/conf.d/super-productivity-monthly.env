# Monthly backup of the super-productivity stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# WebDAV sync files: stop the WebDAV server and copy
BACKUP_SOURCES=/backup/super-productivity
BACKUP_FILENAME="super-productivity-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=super-productivity-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=super-productivity
# Only run commands from containers labeled for this stack
EXEC_LABEL=super-productivity
