# Weekly backup of the bonds stack (schedule and retention: defaults in docker-compose.yml)
# SQLite database: stop and copy the data folder
BACKUP_SOURCES=/backup/bonds
BACKUP_FILENAME="bonds-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=bonds-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=bonds
# Only run commands from containers labeled for this stack
EXEC_LABEL=bonds
