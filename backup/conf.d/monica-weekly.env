# Weekly backup of the monica stack (schedule and retention: defaults in docker-compose.yml)
# mariadb-dump to db-dump/ (label on the db service)
BACKUP_SOURCES=/backup/monica
BACKUP_FILENAME="monica-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=monica-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=monica
