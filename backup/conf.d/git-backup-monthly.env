# Monthly backup of the git-backup stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# Plain files
BACKUP_SOURCES=/backup/git-backup
BACKUP_FILENAME="git-backup-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=git-backup-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=git-backup
