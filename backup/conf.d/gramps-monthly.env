# Monthly backup of the gramps stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# No command-line export (only Gramps XML via the UI): stop and copy the volumes
BACKUP_SOURCES=/backup/gramps
BACKUP_FILENAME="gramps-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=gramps-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=gramps
# Only run commands from containers labeled for this stack
EXEC_LABEL=gramps
