# Weekly backup of the pocketid stack (schedule and retention: defaults in docker-compose.yml)
# SQLite database: stop and copy the data folder (pocket-id export is still experimental)
BACKUP_SOURCES=/backup/pocketid
BACKUP_FILENAME="pocketid-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=pocketid-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=pocketid
# Only run commands from containers labeled for this stack
EXEC_LABEL=pocketid
