# Backup of the git-backup stack
# Plain files
BACKUP_SOURCES=/backup/git-backup
BACKUP_ARCHIVE=/archive/git-backup
BACKUP_FILENAME="git-backup-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=git-backup-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=git-backup
