# Backup of the actual-budget stack
# No server-side backup command: stop and copy the data folder
BACKUP_SOURCES=/backup/actual-budget
BACKUP_ARCHIVE=/archive/actual-budget
BACKUP_FILENAME="actual-budget-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=actual-budget-
BACKUP_STOP_DURING_BACKUP_LABEL=actual-budget
# Only run commands from containers labeled for this stack
EXEC_LABEL=actual-budget
