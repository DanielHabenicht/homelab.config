# Monthly backup of the trilium stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# Trilium's own daily/weekly/monthly database copies (up to a day old), no need to stop it
BACKUP_SOURCES=/backup/trilium
BACKUP_FILENAME="trilium-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=trilium-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=trilium
