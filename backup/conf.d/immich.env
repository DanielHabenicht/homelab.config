# Backup of the immich stack
# The photo library is large and every run is a full archive, so this runs
# weekly (Sunday 04:00) and keeps four weeks instead of the daily default.
BACKUP_CRON_EXPRESSION="0 4 * * 0"
BACKUP_RETENTION_DAYS=28
BACKUP_SOURCES=/backup/immich
BACKUP_FILENAME="immich-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=immich-
# Immich keeps running: its live postgres directory is excluded (see
# BACKUP_EXCLUDE_REGEXP in docker-compose.yml) and restored from the
# database dumps Immich itself writes to library/backups.
BACKUP_STOP_DURING_BACKUP_LABEL=none
