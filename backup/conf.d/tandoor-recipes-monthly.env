# Monthly backup of the tandoor-recipes stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# pg_dumpall to db-dump/ (label on the db service)
BACKUP_SOURCES=/backup/tandoor-recipes
BACKUP_FILENAME="tandoor-recipes-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=tandoor-recipes-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=tandoor-recipes
