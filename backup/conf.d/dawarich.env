# Backup of the dawarich stack
# pg_dumpall to db-dump/ (label on the db service) + storage/
BACKUP_SOURCES=/backup/dawarich
BACKUP_FILENAME="dawarich-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=dawarich-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=dawarich
