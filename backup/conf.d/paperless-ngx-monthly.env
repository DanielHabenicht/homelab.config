# Monthly backup of the paperless-ngx stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# document_exporter to export/ (label on the webserver service)
BACKUP_SOURCES=/backup/paperless-ngx
BACKUP_FILENAME="paperless-ngx-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=paperless-ngx-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=paperless-ngx
