# Monthly backup of the bonds stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# SQLite database: stop and copy the data folder
BACKUP_SOURCES=/backup/bonds
BACKUP_FILENAME="bonds-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=bonds-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=bonds
# Only run commands from containers labeled for this stack
EXEC_LABEL=bonds
