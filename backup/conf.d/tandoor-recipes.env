# Backup of the tandoor-recipes stack
BACKUP_SOURCES=/backup/tandoor-recipes
BACKUP_FILENAME="tandoor-recipes-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=tandoor-recipes-
# Stops all containers labeled docker-volume-backup.stop-during-backup=tandoor-recipes
BACKUP_STOP_DURING_BACKUP_LABEL=tandoor-recipes
