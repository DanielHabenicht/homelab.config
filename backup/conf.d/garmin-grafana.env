# Backup of the garmin-grafana stack
# InfluxDB 1.x and Grafana: stop both and copy their data folders
BACKUP_SOURCES=/backup/garmin-grafana
BACKUP_FILENAME="garmin-grafana-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=garmin-grafana-
BACKUP_STOP_DURING_BACKUP_LABEL=garmin-grafana
# Only run commands from containers labeled for this stack
EXEC_LABEL=garmin-grafana
