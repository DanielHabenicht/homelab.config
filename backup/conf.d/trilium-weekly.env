# Weekly backup of the trilium stack (schedule and retention: defaults in docker-compose.yml)
# Trilium's own daily/weekly/monthly database copies (up to a day old), no need to stop it
BACKUP_SOURCES=/backup/trilium
BACKUP_FILENAME="trilium-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=trilium-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=trilium
