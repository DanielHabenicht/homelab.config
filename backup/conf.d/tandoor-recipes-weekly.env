# Weekly backup of the tandoor-recipes stack (schedule and retention: defaults in docker-compose.yml)
# pg_dumpall to db-dump/ (label on the db service)
BACKUP_SOURCES=/backup/tandoor-recipes
BACKUP_FILENAME="tandoor-recipes-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=tandoor-recipes-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=tandoor-recipes
