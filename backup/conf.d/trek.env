# Backup of the trek stack
# SQLite database: stop and copy the data and uploads folders
BACKUP_SOURCES=/backup/trek
BACKUP_FILENAME="trek-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=trek-
BACKUP_STOP_DURING_BACKUP_LABEL=trek
# Only run commands from containers labeled for this stack
EXEC_LABEL=trek
