# Monthly backup of the ubiquiti stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# Only the controller's own autobackups (.unf files)
BACKUP_SOURCES=/backup/ubiquiti
BACKUP_FILENAME="ubiquiti-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=ubiquiti-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=ubiquiti
