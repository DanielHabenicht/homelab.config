# Backup of the victoriametrics stack
# Stop and copy the data folder (takes a few seconds, Home Assistant retries the writes)
BACKUP_SOURCES=/backup/victoriametrics
BACKUP_FILENAME="victoriametrics-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=victoriametrics-
BACKUP_STOP_DURING_BACKUP_LABEL=victoriametrics
# Only run commands from containers labeled for this stack
EXEC_LABEL=victoriametrics
