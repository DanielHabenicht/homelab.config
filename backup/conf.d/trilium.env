# Backup of the trilium stack
# SQLite database: stop and copy the data folder
BACKUP_SOURCES=/backup/trilium
BACKUP_FILENAME="trilium-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=trilium-
BACKUP_STOP_DURING_BACKUP_LABEL=trilium
# Only run commands from containers labeled for this stack
EXEC_LABEL=trilium
