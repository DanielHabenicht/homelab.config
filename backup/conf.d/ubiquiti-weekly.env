# Weekly backup of the ubiquiti stack (schedule and retention: defaults in docker-compose.yml)
# Only the controller's own autobackups (.unf files)
BACKUP_SOURCES=/backup/ubiquiti
BACKUP_FILENAME="ubiquiti-weekly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=ubiquiti-weekly-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=ubiquiti
