# Backup of the paperless-ngx stack
# document_exporter to export/ (label on the webserver service)
BACKUP_SOURCES=/backup/paperless-ngx
BACKUP_ARCHIVE=/archive/paperless-ngx
BACKUP_FILENAME="paperless-ngx-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=paperless-ngx-
BACKUP_STOP_DURING_BACKUP_LABEL=none
# Only run commands from containers labeled for this stack
EXEC_LABEL=paperless-ngx
