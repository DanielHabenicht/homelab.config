# Monthly backup of the actual-budget stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# No server-side backup command: stop and copy the data folder
BACKUP_SOURCES=/backup/actual-budget
BACKUP_FILENAME="actual-budget-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=actual-budget-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=actual-budget
# Only run commands from containers labeled for this stack
EXEC_LABEL=actual-budget
