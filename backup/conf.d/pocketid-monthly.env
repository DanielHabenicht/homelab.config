# Monthly backup of the pocketid stack, on the 1st at 04:00, 3 versions kept
BACKUP_CRON_EXPRESSION="0 4 1 * *"
BACKUP_RETENTION_DAYS=75
# SQLite database: stop and copy the data folder (pocket-id export is still experimental)
BACKUP_SOURCES=/backup/pocketid
BACKUP_FILENAME="pocketid-monthly-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_PRUNING_PREFIX=pocketid-monthly-
BACKUP_STOP_DURING_BACKUP_LABEL=pocketid
# Only run commands from containers labeled for this stack
EXEC_LABEL=pocketid
