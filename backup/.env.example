# SMB share the backups are written to. Use the IP address if the host
# cannot resolve the NAS name. SMB_SHARE may include a sub folder,
# e.g. "backups/homelab" (the folder must exist).
SMB_HOST=192.168.1.10
SMB_SHARE=backups
SMB_USERNAME=homelab
# Must not contain a comma
SMB_PASSWORD=secret

# Archives are encrypted with age using this passphrase.
# Leave empty to store unencrypted archives.
# Keep a copy somewhere outside the homelab, you need it for restores!
AGE_PASSPHRASE=
