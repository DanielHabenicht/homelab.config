# Database (only reachable inside the stack)
POSTGRES_PASSWORD=change-me

# Rails secret, generate with: openssl rand -hex 64
# Keep a copy outside the homelab, it is not part of the backup.
SECRET_KEY_BASE=change-me

# Pocket ID client (https://auth.home.aquiver.de)
# Callback URL: https://timeline.home.aquiver.de/users/auth/openid_connect/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Set to false once your Pocket ID login works (see README.md)
ALLOW_EMAIL_PASSWORD_LOGIN=true
