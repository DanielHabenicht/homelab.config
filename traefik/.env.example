# Normally provided by Komodo: komodo/stacks/traefik.toml (values from the
# site's variables) and komodo/sites/<site>/secrets/traefik.env (secrets)
DOMAIN=home.aquiver.de
DATA_ROOT=/mnt/data/homelab
ACME_EMAIL=you@example.de
# Optional: route dns.<DOMAIN> to this upstream
DNS_SERVER_URL=http://192.168.178.174:5380/
# Secret: Cloudflare API token with Zone:Read and DNS:Edit for the zone
CF_DNS_API_TOKEN=secret
