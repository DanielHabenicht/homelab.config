# Template for another machine, e.g. at my parents' place.
#
# 1. Copy to parents.toml (only *.toml files are synced).
# 2. Add PARENTS_DOMAIN and PARENTS_DATA_ROOT to ../variables.toml.
# 3. Create the PARENTS_* secrets in the Komodo UI (Settings -> Variables).
# 4. Create Pocket ID clients for this machine's apps.
# 5. Install Periphery on the machine (komodo/README.md), connect as "parents".
#
# Pick the stacks you need, everything else is copied from home.toml.
# Remove DNS_SERVER_URL in the traefik stack, or point it to a DNS server there.

[[server]]
name = "parents"
[server.config]
enabled = true

##

[[stack]]
name = "parents-traefik"
description = "Reverse proxy, TLS certificates"
[stack.config]
server = "parents"
repo = "DanielHabenicht/homelab.config"
branch = "main"
run_directory = "traefik"
file_paths = ["docker-compose.yml"]
project_name = "traefik"
poll_for_updates = true
# Prepare a fresh machine: shared proxy network and certificate store
pre_deploy.command = """
docker network inspect traefik_backbone >/dev/null 2>&1 || docker network create --internal traefik_backbone
mkdir -p [[PARENTS_DATA_ROOT]]/traefik
test -e [[PARENTS_DATA_ROOT]]/traefik/acme.json || install -m 600 /dev/null [[PARENTS_DATA_ROOT]]/traefik/acme.json
"""
environment = """
DOMAIN = [[PARENTS_DOMAIN]]
DATA_ROOT = [[PARENTS_DATA_ROOT]]
ACME_EMAIL = [[ACME_EMAIL]]
CF_DNS_API_TOKEN = [[PARENTS_TRAEFIK_CF_DNS_API_TOKEN]]
"""

##

[[stack]]
name = "parents-homepage"
description = "Dashboard"
[stack.config]
server = "parents"
repo = "DanielHabenicht/homelab.config"
branch = "main"
run_directory = "homepage"
file_paths = ["docker-compose.yml"]
project_name = "homepage"
poll_for_updates = true
environment = """
DOMAIN = [[PARENTS_DOMAIN]]
DATA_ROOT = [[PARENTS_DATA_ROOT]]
"""

##

[[stack]]
name = "parents-pocketid"
description = "Single sign-on (OIDC) for all apps"
[stack.config]
server = "parents"
repo = "DanielHabenicht/homelab.config"
branch = "main"
run_directory = "pocketid"
file_paths = ["docker-compose.yml"]
project_name = "pocketid"
poll_for_updates = true
environment = """
DOMAIN = [[PARENTS_DOMAIN]]
DATA_ROOT = [[PARENTS_DATA_ROOT]]
ENCRYPTION_KEY = [[PARENTS_POCKETID_ENCRYPTION_KEY]]
"""

##

[[stack]]
name = "parents-immich"
description = "Photos"
[stack.config]
server = "parents"
repo = "DanielHabenicht/homelab.config"
branch = "main"
run_directory = "immich"
file_paths = ["docker-compose.yml"]
project_name = "immich"
poll_for_updates = true
environment = """
DOMAIN = [[PARENTS_DOMAIN]]
DATA_ROOT = [[PARENTS_DATA_ROOT]]
TZ = Europe/Berlin
DB_USERNAME = [[PARENTS_IMMICH_DB_USERNAME]]
DB_PASSWORD = [[PARENTS_IMMICH_DB_PASSWORD]]
DB_DATABASE_NAME = [[PARENTS_IMMICH_DB_DATABASE_NAME]]
"""

##

[[stack]]
name = "parents-backup"
description = "Nightly encrypted backups to the NAS"
[stack.config]
server = "parents"
repo = "DanielHabenicht/homelab.config"
branch = "main"
run_directory = "backup"
file_paths = ["docker-compose.yml"]
project_name = "backup"
poll_for_updates = true
environment = """
DOMAIN = [[PARENTS_DOMAIN]]
DATA_ROOT = [[PARENTS_DATA_ROOT]]
SMB_HOST = [[PARENTS_BACKUP_SMB_HOST]]
SMB_SHARE = [[PARENTS_BACKUP_SMB_SHARE]]
SMB_USERNAME = [[PARENTS_BACKUP_SMB_USERNAME]]
SMB_PASSWORD = [[PARENTS_BACKUP_SMB_PASSWORD]]
AGE_PASSPHRASE = [[PARENTS_BACKUP_AGE_PASSPHRASE]]
"""
