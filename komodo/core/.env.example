# Used in compose.yaml
DOMAIN=home.aquiver.de
DATA_ROOT=/mnt/data/homelab

# Database (generate with: openssl rand -hex 24)
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=secret

KOMODO_TITLE=Homelab
TZ=Europe/Berlin

# First login, change the password afterwards
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=secret
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false

# GitHub webhook secret (openssl rand -hex 32), see ../README.md
KOMODO_WEBHOOK_SECRET=secret
KOMODO_JWT_SECRET=secret
KOMODO_JWT_TTL=1-day

KOMODO_MONITORING_INTERVAL=15-sec
KOMODO_RESOURCE_POLL_INTERVAL=5-min

# Optional: log in with Pocket ID
KOMODO_OIDC_ENABLED=false
# KOMODO_OIDC_PROVIDER=https://auth.home.aquiver.de
# KOMODO_OIDC_CLIENT_ID=
# KOMODO_OIDC_CLIENT_SECRET=
