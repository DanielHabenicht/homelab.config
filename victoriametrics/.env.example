# Basic auth for VictoriaMetrics (web UI, Home Assistant writes, vmctl).
# Use the same values in the Home Assistant InfluxDB integration.
VM_USERNAME=homeassistant
VM_PASSWORD=change-me

# Only needed once for the migration (docker compose run --rm vmctl).
# InfluxDB add-on of Home Assistant: use the IP of Home Assistant and the
# port shown in the add-on's "Network" settings (default 8086).
INFLUX_ADDR=http://192.168.178.10:8086
INFLUX_USER=homeassistant
INFLUX_PASSWORD=secret
INFLUX_DATABASE=homeassistant
